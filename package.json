{
	"name": "movie-together",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"dev:local": "node scripts/dev-local.mjs",
		"backend:local": "tsx backend/local/main.ts",
		"build": "vite build",
		"copy-static": "cp -r static/* dist/",
		"preview": "vite preview",
		"clean-db": "node --experimental-json-modules clean-db.js",
		"stats": "node --experimental-json-modules stats.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:skeleton": "tsc --noEmit -p tsconfig.skeleton.json && node scripts/check-boundaries.mjs",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:ui": "svelte-check --tsconfig ./tsconfig.adapter.json --threshold error",
		"check:backend": "tsc --noEmit -p tsconfig.backend.json",
		"check:all": "npm run check:skeleton && npm run check:ui && npm run check:backend && npm run test && npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@amplitude/analytics-browser": "^2.29.0",
		"@playwright/test": "^1.56.1",
		"@sentry/svelte": "^10.23.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tsconfig/svelte": "^5.0.2",
		"@types/ws": "^8.18.2",
		"fast-check": "^4.10.1",
		"firebase": "^12.1.0",
		"firebase-admin": "^14.3.0",
		"jsdom": "^30.1.0",
		"prettier-bytes": "^1.0.4",
		"sass": "^1.93.2",
		"svelte": "^5.34.3",
		"svelte-check": "^4.3.3",
		"svelte-i18n": "^4.0.0",
		"tslib": "^2.6.2",
		"tsx": "^4.23.15",
		"typescript": "^5.5.0",
		"uikit": "^3.24.2",
		"vidstack": "^1.11.30",
		"vite": "^7.1.9",
		"vite-plugin-pwa": "^1.0.0",
		"vitest": "^5.0.1",
		"ws": "^8.22.0"
	},
	"type": "module"
}
